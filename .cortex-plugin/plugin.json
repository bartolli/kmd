{
  "name": "wiki-sdd",
  "version": "0.21.2",
  "description": "Wiki-native spec-driven development loop for the llm-wiki agent wiki: bootstrap a project scope, grill intent into a glossary, synthesize PRDs and user stories, triage stories through a state machine, slice into tracker issues, and implement slices via red-green-refactor TDD.",
  "author": {
    "name": "Angel Bartolli"
  },
  "skills": [
    "./plugins/coco/wiki-sdd/skills"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CORTEX_PLUGIN_ROOT}/plugins/coco/wiki-sdd/hooks/run-kmd-hook.mjs\" hook session-start --defer-orientation",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CORTEX_PLUGIN_ROOT}/plugins/coco/wiki-sdd/hooks/run-kmd-hook.mjs\" hook prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CORTEX_PLUGIN_ROOT}/plugins/coco/wiki-sdd/hooks/run-kmd-hook.mjs\" hook pretool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit|write|apply_patch|bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CORTEX_PLUGIN_ROOT}/plugins/coco/wiki-sdd/hooks/run-kmd-hook.mjs\" hook posttool --harness claude",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CORTEX_PLUGIN_ROOT}/plugins/coco/wiki-sdd/hooks/run-kmd-hook.mjs\" hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "wiki": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CORTEX_PLUGIN_ROOT}/plugins/src/wiki-sdd/scripts/run-kmd.mjs",
        "mcp"
      ],
      "env": {
        "WIKI_VAULT": "${WIKI_VAULT:-}",
        "KMD_PROJECT_DIR": "${KMD_PROJECT_DIR:-}",
        "LOG_LEVEL": "${WIKI_MCP_LOG_LEVEL:-info}"
      }
    }
  }
}
