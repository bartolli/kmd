# pnpm 11's pre-run deps check spawns `pnpm install`, which exits non-zero while
# build scripts (esbuild) are unapproved under `onlyBuiltDependencies: []`. The
# toolchain works regardless (esbuild ships its binary via a platform package),
# so skip the pre-flight and keep the no-build policy intact. Re-enable if the
# build policy changes (e.g. `pnpm approve-builds`).
verify-deps-before-run=false
