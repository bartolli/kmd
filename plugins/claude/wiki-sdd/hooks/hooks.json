{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-kmd-hook.mjs",
              "hook",
              "prompt",
              "${user_config.vault_path}"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-kmd-hook.mjs",
              "hook",
              "pretool",
              "${user_config.vault_path}",
              "--harness",
              "claude"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-kmd-hook.mjs",
              "hook",
              "posttool",
              "${user_config.vault_path}",
              "--harness",
              "claude"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-kmd-hook.mjs",
              "hook",
              "stop",
              "${user_config.vault_path}"
            ]
          }
        ]
      }
    ]
  }
}
