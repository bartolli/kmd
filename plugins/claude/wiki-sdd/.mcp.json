{
  "mcpServers": {
    "wiki": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-kmd.mjs",
        "mcp",
        "--default-root",
        "${user_config.vault_path}"
      ],
      "env": {
        "KMD_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "LOG_LEVEL": "info"
      }
    }
  }
}
