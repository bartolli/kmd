{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-kmd-hook.mjs\" hook prompt \"${WIKI_VAULT:-$HOME/llm-wiki/vault}\"",
            "timeout": 30,
            "statusMessage": "wiki gate triggers"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-kmd-hook.mjs\" hook posttool \"${WIKI_VAULT:-$HOME/llm-wiki/vault}\" --harness claude",
            "timeout": 60,
            "statusMessage": "wiki validate + sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-kmd-hook.mjs\" hook stop \"${WIKI_VAULT:-$HOME/llm-wiki/vault}\"",
            "timeout": 60,
            "statusMessage": "wiki handoff gate"
          }
        ]
      }
    ]
  }
}
